# ─── Listener ────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# ─── Supervisor (reload without dropping Claude Code sessions) ───────────────
# serve = supervisor on HOST:PORT + a forked worker; `jev-router reload` swaps the worker.
# false: the gateway listens directly (use it for `npm run dev`).
SUPERVISOR_ENABLED=true
# Loopback-only port for `jev-router reload`. 0 = PORT + 1.
CONTROL_PORT=0
# How long a replaced worker may finish open streams before they are cut.
RELOAD_DRAIN_MS=120000

# ─── Primary provider: Anthropic (heavy lifting) ─────────────────────────────
ANTHROPIC_UPSTREAM_URL=https://api.anthropic.com
# passthrough: forward the client's own credential (API key or claude.ai login). Proxy holds no secret.
# inject:      proxy replaces client credentials with ANTHROPIC_API_KEY below.
UPSTREAM_AUTH_MODE=passthrough
# ANTHROPIC_API_KEY=sk-ant-...
# Required in inject mode when HOST is not loopback; clients send it as ANTHROPIC_AUTH_TOKEN.
# PROXY_AUTH_TOKEN=change-me-to-a-long-random-string
UPSTREAM_TIMEOUT_MS=600000
BODY_LIMIT_BYTES=33554432

# ─── Cheap provider: any OpenAI-compatible API (simple tasks) ────────────────
# Default: Ollama Cloud through the local Ollama daemon (free plan, no key here).
#   one-time: `ollama signin` then `ollama pull gpt-oss:20b-cloud`
# The daemon forwards the prompt to ollama.com: your code leaves the machine.
# Other presets (README): Groq https://api.groq.com/openai/v1 + gsk_... key,
#                         OpenRouter https://openrouter.ai/api/v1 + sk-or-... key.
CHEAP_BASE_URL=http://127.0.0.1:11434/v1
# Ollama ignores the key, but the router requires a non-empty value.
CHEAP_API_KEY=ollama
CHEAP_MODEL=gpt-oss:20b-cloud
CHEAP_MAX_OUTPUT_TOKENS=8192
CHEAP_CONTEXT_TOKENS=131072
CHEAP_TIMEOUT_MS=60000
# Standard tier: JEV level-2 work ("standard") on a bigger cheap model, same
# CHEAP_BASE_URL and key. `off` = level 2 stays on Anthropic (the old behavior).
#   one-time: `ollama pull gemma4:31b-cloud` (free plan; tools + 262144-token window)
CHEAP_MODEL_STANDARD=gemma4:31b-cloud
# Its context window; defaults to CHEAP_CONTEXT_TOKENS. `ollama show gemma4:31b-cloud` reports 262144.
# CHEAP_STANDARD_CONTEXT_TOKENS=262144
# Poll GET {CHEAP_BASE_URL}/models; while it is down, cheap turns go to Anthropic
# without a wasted attempt (reason skipped:cheap-unhealthy).
CHEAP_HEALTH_ENABLED=true
CHEAP_HEALTH_INTERVAL_MS=30000
# On a transient failure (network error or HTTP 5xx), retry once quickly.
CHEAP_RETRY=true
CHEAP_RETRY_DELAY_MS=250
CHEAP_RETRY_HEADERS_TIMEOUT_MS=15000

# ─── System One classifier ───────────────────────────────────────────────────
# jev: TypeSafe JEV (production). heuristic: offline keyword mock (dev only).
CLASSIFIER=jev
TYPESAFE_API_KEY=
JEV_API_URL=https://api.typesafe.ai/v1/systemone
# Pin the version the 0.9 threshold was tuned on; bump after scripts/eval-jev.ts.
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=1500
CLASSIFIER_MAX_CHARS=4000

# ─── Routing policy ──────────────────────────────────────────────────────────
# Trivial tier (CHEAP_MODEL) only when P(simple) >= this (0–1). Not argmax — see README.
# 0.9 trades savings for fewer silent wrong answers on the small model. The
# heuristic classifier tops out at 0.825, so with CLASSIFIER=heuristic use 0.8.
ROUTER_MIN_CHEAP_PROBABILITY=0.9
# Standard tier (CHEAP_MODEL_STANDARD) when P(simple) + P(standard) >= this.
ROUTER_MIN_STANDARD_PROBABILITY=0.75
# Legacy, read only with CHEAP_MODEL_STANDARD=off: `cheap` sends level-2 mass to CHEAP_MODEL.
ROUTER_STANDARD_ROUTE=primary
# x-claude-code-request-class values always sent to the primary
# (needs CLAUDE_CODE_GATEWAY_HINT_HEADERS=1 on the Claude Code side).
ROUTER_PRIMARY_CLASSES=auxiliary,compaction
# On a session's first turn, if the user asks what to do next, instruct the cheap model
# to read project files (README, CLAUDE.md, plan documents) with its tools rather than guessing.
CHEAP_READ_FIRST_HINT=true
# Promotes a read-first turn to the standard tier (requires CHEAP_MODEL_STANDARD).
CHEAP_READ_FIRST_STANDARD=true
# JEV picks Claude model + effort when a main session starts on Claude: Sonnet 5.5 (half the
# price of Opus 5.5) for non-structural work, Opus high for structural/risky. Re-picked only
# where the cache is rebuilt anyway (session start, climb from a cheap tier, compaction).
# Only the client default (Opus 5.5 medium) is rewritten; /model and /effort win. A 400 on the
# rewritten request resends the original; if that one is accepted, profiles stay off for the session.
PRIMARY_PROFILES=false
# On Anthropic 429/529, retry the request on the cheap provider instead of failing. See README rule 5.
FAILOVER_ON_PRIMARY_RATE_LIMIT=true

# ─── Quota routing (claude.ai 5-hour / 7-day windows) ────────────────────────
# Read from every Anthropic response (anthropic-ratelimit-unified-*). false = ignore the quota.
QUOTA_ROUTING=true
# From this share of the binding window on, the cheap bars drop to the two values below.
QUOTA_PRESSURE=0.80
# From this share on, a new human turn of a Claude-pinned session is re-classified
# and may go cheap; compaction no longer keeps a session on Claude.
QUOTA_CRITICAL=0.95
QUOTA_PRESSURE_MIN_CHEAP=0.7
QUOTA_PRESSURE_MIN_STANDARD=0.6
SESSION_TTL_MS=21600000

# ─── Telemetry (cost audit) ──────────────────────────────────────────────────
# One SQLite row per /v1/messages exchange; read it with `jev-router stats`.
TELEMETRY_ENABLED=true
# Default: ~/.jev-router/telemetry.db (or $JEV_ROUTER_HOME/telemetry.db).
# TELEMETRY_DB_PATH=
# Log hashes and token lengths for deep inspection of agent behavior without recording secrets.
TELEMETRY_DIAGNOSTICS=false

# ─── Net cost (`jev-router stats`) ───────────────────────────────────────────
# Cheap provider price in USD per million tokens. Default 0 = free (Ollama local or
# Ollama Cloud free plan). For Groq/OpenRouter, copy the prices from their pricing page.
# CHEAP_PRICE_INPUT_PER_MTOK=0.075
# CHEAP_PRICE_OUTPUT_PER_MTOK=0.30
# TypeSafe JEV classifier price in USD per million tokens (it bills per token).
# Each classification is ~450 input / ~20 output tokens; stats nets it out of the savings.
# JEV_PRICE_INPUT_PER_MTOK=
# JEV_PRICE_OUTPUT_PER_MTOK=
# Anthropic prices come from a built-in list-price table per model.
# Set these only to override every model (negotiated contract):
# PRIMARY_PRICE_INPUT_PER_MTOK=
# PRIMARY_PRICE_OUTPUT_PER_MTOK=
# PRIMARY_PRICE_CACHE_READ_PER_MTOK=
# Cache write premium over input: 1.25 (5-minute TTL) or 2 (1-hour TTL).
CACHE_WRITE_MULTIPLIER=1.25

# ─── Gemini tier (Antigravity CLI subscription) ──────────────────────────────
# An optional tier for text-only turns (explanations, design, planning) using
# Gemini through the Antigravity CLI (agy) subscription.
# Spares Claude quota. No extra API key required.
# The child process is started WITHOUT GEMINI_API_KEY, GOOGLE_API_KEY, etc. (stripped from its env)
# so agy always uses the Google account login and never an API key.
GEMINI_TIER=off
# Binary path. Default on Windows: %LOCALAPPDATA%\agy\bin\agy.exe, else agy.
# GEMINI_TIER_BIN=
# GEMINI_TIER_MODEL=gemini-3.8-flash-high
# Real answers take ~10-25s for a long explanation with gemini-3.8-flash-high, so 90000 may be needed.
# GEMINI_TIER_TIMEOUT_MS=60000
# Minimum JEV P(text_answer_suffices) to use Gemini.
# GEMINI_TIER_MIN_TEXT_ONLY=0.8
# The lowered bar under QUOTA_PRESSURE.
# GEMINI_TIER_PRESSURE_MIN_TEXT_ONLY=0.6
# If true, new human turns of a Claude-pinned session are also checked for
# text-only eligibility. Costs one extra JEV call per human turn in a Claude session.
# GEMINI_TIER_FROM_PRIMARY=true
# Max concurrent agy instances (1-4). Queueing is skipped: if busy, it fails over to the next tier.
# GEMINI_TIER_MAX_CONCURRENCY=1
# Max rendered transcript characters. Older messages are omitted if exceeded.
# GEMINI_TIER_MAX_PROMPT_CHARS=200000
# Breaker: number of consecutive failures before opening.
# GEMINI_TIER_BREAKER_FAILURES=3
# Breaker: cooldown ms before a half-open trial.
# GEMINI_TIER_BREAKER_COOLDOWN_MS=300000
# Custom HOME/USERPROFILE for the isolated agy profile. Defaults to <jevHome()>/agy-home.
# GEMINI_TIER_HOME=

# ─── Cursor tier (failover only, Cursor subscription) ────────────────────────
# NOT part of normal JEV routing: Cursor only serves when Claude hits a
# 429/529 (failover cascade Claude -> Cursor -> Gemini -> cheap).
# One-time: install Cursor and run `agent login` once (subscription login in
# ~/.cursor wins; CURSOR_API_KEY is stripped from the child env).
CURSOR_TIER=off
# Agent root holding versions\<date>\node.exe + index.js. Default: %LOCALAPPDATA%\cursor-agent.
# CURSOR_TIER_BIN=
# CURSOR_TIER_MODEL=auto
# Cold CLI latency is high.
# CURSOR_TIER_TIMEOUT_MS=180000
# Windows command-line cap: rendered prompts over this never spawn.
# CURSOR_TIER_MAX_PROMPT_CHARS=24000
# CURSOR_TIER_MAX_CONCURRENCY=1
# Breaker: consecutive failures before opening / cooldown ms before a half-open trial.
# CURSOR_TIER_BREAKER_FAILURES=3
# CURSOR_TIER_BREAKER_COOLDOWN_MS=300000

# ─── Context Injection Hook ──────────────────────────────────────────────────
# Mode of operation: `inject` (score and inject), `shadow` (score and log only), or `off`
CONTEXT_MODE=inject
# Threshold for current project items (0–1)
CONTEXT_L_CURRENT=0.8
# Threshold for other projects' items (0–1)
CONTEXT_L_OTHER=0.9
# Maximum items to inject in the prompt context
CONTEXT_MAX_ITEMS=5
# Maximum characters for injected prompt context
CONTEXT_MAX_CHARS=1500
# Global timeout in milliseconds for the context evaluation
CONTEXT_TIMEOUT_MS=3000
# Whole-hook budget in milliseconds (1000-7000, default 5000). Past it the hook exits 0 with no
# context, well before Claude Code's own hook timeout; the pipeline deadline is capped at budget - 1500.
# A cwd that is not a project is recorded as skipped_cwd and costs no JEV call.
CONTEXT_HOOK_BUDGET_MS=5000
# Root directory to search for dependency graphs (e.g., C:\Dev)
# CONTEXT_GRAPH_ROOT=
# Path to the ai-memory executable
CONTEXT_AI_MEMORY_BIN=ai-memory

# Status line: append the router's last Claude quota reading (cota 42% 5h). Off by default.
# STATUSLINE_QUOTA=1
